# App (inlined by Expo at bundle time)
# Seeds a fictional household so the app is useful without a server.
EXPO_PUBLIC_DEMO=0
# Sync server for new households. Leave empty for local-only households.
# iOS simulator: ws://localhost:8043  Android emulator: ws://10.0.2.2:8043
EXPO_PUBLIC_SYNC_URL=ws://localhost:8043

# Sync server
PORT=8043
# Where room snapshots are written. One JSON file per household.
DATA_DIR=./data
# Optional LLM quick-add. Any AI Gateway model id, for example openai/gpt-5-mini
# or google/gemini-2.5-flash. Leave empty to keep quick-add fully on-device.
QUICK_ADD_MODEL=
AI_GATEWAY_API_KEY=
